# SafePath Environment Configuration Template
# Copy this file to .env.local for local overrides. Never commit actual secret keys.

# Backend API server configuration
HAZARD_API_HOST=127.0.0.1
HAZARD_API_PORT=3100
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend API base URL (leave blank for local dev proxy to /api, or set for deployed backend)
# Example for deployed backend: VITE_API_BASE_URL=https://safepath-api.onrender.com
VITE_API_BASE_URL=

# Optional Carto basemap API key for Voyager / Dark Matter basemaps
VITE_CARTO_API_KEY=

