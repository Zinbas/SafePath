{
  "name": "safe-route-guwahati-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx services/hazard-ingestion/server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:risk && npm run test:demo && npm run test:ingest",
    "test:demo": "tsx frontend/data/demoHazards.test.ts",
    "test:risk": "tsx frontend/riskEngine/riskEngine.test.ts",
    "test:ingest": "tsx --test services/hazard-ingestion/tests/*.test.ts",
    "typecheck:ingest": "tsc -p services/hazard-ingestion/tsconfig.json",
    "smoke:gdelt": "tsx services/hazard-ingestion/scripts/smokeGdelt.ts",
    "verify": "npm run test:risk && npm run test:demo && npm run test:ingest && npm run typecheck:ingest && tsc -b && vite build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15"
  }
}
